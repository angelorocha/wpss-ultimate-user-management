<?xml version="1.0"?>
<ruleset name="WPSS Ultimate User Management">
    <description>WordPress Coding Standards ruleset for wpss-ultimate-user-management.</description>

    <file>.</file>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/js/*.min.js</exclude-pattern>
    <exclude-pattern>*/assets/src/js/select2.js</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress-Extra">
        <!--
            This plugin uses composer PSR-4 autoloading (admin/classes/ ->
            WpssUserManager\Admin\*) plus a matching custom autoloader, both
            keyed off the current PascalCase class file names (e.g.
            WPSSCaps.php). Renaming to WP-core-style hyphenated file names
            would require rewriting both autoload mechanisms; not worth the
            risk for a purely stylistic sniff.
        -->
        <exclude name="WordPress.Files.FileName"/>
        <!--
            Plugin requires PHP 8.1+ and intentionally uses short array
            syntax `[]` throughout, consistent with modern WordPress core
            and current plugin conventions.
        -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <rule ref="WordPress-Docs">
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!--
        Template partials under admin/templates are `require`d from inside a
        method body (see WPSSAdminFrontend::render()), so their local
        variables are not actually globals - PHPCS just can't see the
        enclosing function scope when it lints the file standalone. This
        sniff is not actionable there without prefixing every local template
        variable, which would hurt readability for no real benefit.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>admin/templates/*</exclude-pattern>
    </rule>

    <!--
        Same reasoning as PrefixAllGlobals above: these are local loop/variable
        names (e.g. $role, $post, $tab) inside template partials that are
        require()d from inside a method, not real assignments to WordPress's
        global $role/$post/etc. Excluded only for templates; a genuine global
        override elsewhere (e.g. admin/classes/WPSSAdminPages.php) is handled
        with an inline phpcs:ignore and a justification comment instead.
    -->
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>admin/templates/*</exclude-pattern>
    </rule>

    <config name="minimum_supported_wp_version" value="6.1"/>
</ruleset>
